{
    "name": "northselevator",
    "version": "1.0.0",
    "description": "The coolest home page of NorthWestWind.",
    "main": "out/index.js",
    "scripts": {
        "deep-install": "npm i && npm-run-all install:*",
        "start": "node out/index.js",
        "build": "tsc && npm-run-all build:*",
        "test": "npm run build && npm start",
        "install:main": "cd vite/main && npm i",
        "build:main": "cd vite/main && npm run build",
        "install:uop-editor": "cd uop-editor && npm i",
        "build:uop-editor": "cd uop-editor && npm run build",
        "install:midi-sort": "cd midi-sort && npm i",
        "build:midi-sort": "cd midi-sort && npm run build"
    },
    "author": "NorthWestWind",
    "license": "GPL-3.0-or-later",
    "dependencies": {
        "body-parser": "^1.20.1",
        "compression": "^1.7.5",
        "dotenv": "^16.0.3",
        "ejs": "^3.1.6",
        "express": "^4.18.2",
        "isbot": "^5.1.6",
        "sirv": "^3.0.0"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.2",
        "@types/compression": "^1.7.5",
        "@types/express": "^4.17.14",
        "npm-run-all": "^4.1.5",
        "three": "^0.138.3",
        "ts-node": "^10.9.1",
        "typescript": "^4.8.4"
    }
}
